# Google Cloud service account key (Cloud Console -> IAM & Admin -> Service Accounts)
# The service account email must be added as a user on the Search Console property.
# Provide the downloaded JSON key either as a path ...
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/path/to/service-account.json

# ... or inline as the raw JSON:
# GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'

# Optional: default property to operate on, so tools can omit site_url.
# URL-prefix property: https://example.com/ (trailing slash) or domain property: sc-domain:example.com
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://example.com/

# Optional: register the delete_sitemap and delete_site tools (1/true/yes)
# GOOGLE_SEARCH_CONSOLE_ALLOW_DESTRUCTIVE=1
