{
  "name": "@orellbuehler/search-console-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Google Search Console: query search analytics (clicks, impressions, CTR, position), manage sitemaps and properties, and inspect URL index status over the official Search Console API.",
  "type": "module",
  "bin": {
    "search-console-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/__tests__"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "search-console",
    "google-search-console",
    "seo",
    "webmasters",
    "search-analytics",
    "sitemaps",
    "url-inspection",
    "llm",
    "ai"
  ],
  "author": "Orell Bühler",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrellBuehler/search-console-mcp.git"
  },
  "homepage": "https://github.com/OrellBuehler/search-console-mcp#readme",
  "bugs": {
    "url": "https://github.com/OrellBuehler/search-console-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "jose": "^6.0.11",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.3",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.0"
  }
}
